rules_version = '2';
// ══════════════════════════════════════════════════════════════════
//  Fênix CNPJ — Regras de Segurança do Firestore
//  Projeto: fenix-cnpj-pro
//
//  Como aplicar:
//  1. Acesse console.firebase.google.com
//  2. Selecione o projeto fenix-cnpj-pro
//  3. Menu lateral → Build → Firestore Database
//  4. Aba "Regras" (Rules)
//  5. Cole este conteúdo e clique em "Publicar"
// ══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Dados do usuário ────────────────────────────────────────────
    // Cada usuário só pode ler e escrever seus próprios dados.
    // Nenhum outro usuário, mesmo autenticado, acessa dados alheios.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Histórico de consultas
      match /historico/{cnpj} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;

        // Validações de escrita
        allow write: if request.auth != null
                     && request.auth.uid == userId
                     // tamanho máximo por documento: 500KB
                     && request.resource.size < 500 * 1024;
      }
    }

    // ── Bloqueia qualquer outra coleção ────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
